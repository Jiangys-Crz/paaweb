# Copy with: bash scripts/init-env.sh (generates a unique database password).
COMPOSE_PROJECT_NAME=paaweb
HOST_BIND=0.0.0.0
HOST_PORT=3403
TZ=Asia/Shanghai
POSTGRES_DB=paaweb
POSTGRES_USER=paaweb
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_INIT_ENV

# Public URL used for metadata, certificate verification and email links.
PUBLIC_SITE_URL=http://localhost:3403
# Optional VP system link in the footer; blank hides the link.
PUBLIC_VP_SITE_URL=
# Set true when the public site uses HTTPS.
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
# Empty allows PUBLIC_SITE_URL; a nonempty value replaces the list (comma-separated origins).
CORS_ALLOWED_ORIGINS=

# Optional SMTP. Leave blank until email delivery is configured.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROTOCOL=smtp
SPRING_MAIL_SSL_ENABLED=false
SPRING_MAIL_STARTTLS_ENABLED=true

# Optional integrations and additional image hosts. Leave empty until configured.
HYDRO_BASE_URL=
NEXT_PUBLIC_SCHOOL_OJ_URL=
QQ_BOT_IMAGE_HOSTS=
CRAWLER_SERVICE_URL=http://localhost:8000
